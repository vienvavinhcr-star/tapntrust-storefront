{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tapntrust-insights-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "go.tapntrust.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "secrets": {
    "required": [
      "ADMIN_API_TOKEN",
      "ZEPTOMAIL_API_KEY",
      "GOOGLE_PLACES_API_KEY",
      "SHOPIFY_CLIENT_ID",
      "SHOPIFY_CLIENT_SECRET",
      "RESEND_API_KEY"
    ]
  },
  "assets": {
    "directory": "./assets"
  },
  "vars": {
    "AUTH_BASE_URL": "https://go.tapntrust.com",
    "AUTH_FROM_EMAIL": "contact@tapntrust.com",
    "STOREFRONT_ORIGIN": "https://tapntrust.com",
    "SHOPIFY_SHOP_DOMAIN": "iz8qif-0j.myshopify.com",
    "SHOPIFY_ADMIN_API_VERSION": "2026-07",
    "SHOPIFY_INSIGHTS_VARIANT_ID": "gid://shopify/ProductVariant/48192855376003",
    "SHOPIFY_INSIGHTS_INTRO_SELLING_PLAN_ID": "gid://shopify/SellingPlan/2791899267",
    "SHOPIFY_INSIGHTS_STANDARD_SELLING_PLAN_ID": "gid://shopify/SellingPlan/2791899267",
    "EMAIL_AUTOMATION_CUTOFF": "2026-09-15T00:00:00+10:00"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapntrust-insights",
      "database_id": "f0961fc6-3fff-4ce4-bed5-6900ee0c0d73",
      "migrations_dir": "migrations"
    }
  ]
}
