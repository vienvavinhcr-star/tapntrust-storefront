{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tapntrust-insights-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "go.tapntrust.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["ADMIN_API_TOKEN"]
  },
  "vars": {
    "AUTH_BASE_URL": "https://go.tapntrust.com",
    "AUTH_FROM_EMAIL": "contact@tapntrust.com"
  },
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "allowed_sender_addresses": ["contact@tapntrust.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tapntrust-insights",
      "database_id": "f0961fc6-3fff-4ce4-bed5-6900ee0c0d73",
      "migrations_dir": "migrations"
    }
  ]
}
