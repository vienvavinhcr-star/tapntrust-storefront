# Copy this file to .dev.vars for local development. Never commit the real value.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
ZEPTOMAIL_API_KEY=replace-with-your-zeptomail-agent-send-api-key
GOOGLE_PLACES_API_KEY=replace-with-your-restricted-google-places-api-key
SHOPIFY_CLIENT_ID=replace-with-your-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-your-shopify-client-secret
RESEND_API_KEY=replace-with-your-resend-sending-api-key
# Optional until the two customer PDFs are hosted at stable public HTTPS URLs.
